# Application
APP_NAME="Project Management Archive System"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=5173

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=project_mgmt
POSTGRES_USER=project_mgmt
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://project_mgmt:change-me@postgres:5432/project_mgmt

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key.pem
JWT_SECRET_KEY=dev-secret-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security / CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=100
MAX_UPLOAD_SIZE_MB=50

# OAuth2 / OIDC SSO
OAUTH_GENERIC_ENABLED=false
OAUTH_GENERIC_LABEL=企业账号
OAUTH_GENERIC_CLIENT_ID=
OAUTH_GENERIC_CLIENT_SECRET=
OAUTH_GENERIC_AUTHORIZE_URL=
OAUTH_GENERIC_TOKEN_URL=
OAUTH_GENERIC_USERINFO_URL=
OAUTH_GENERIC_REDIRECT_URI=http://localhost:5173/login?oauth_provider=generic_oidc
OAUTH_GENERIC_BIND_REDIRECT_URI=http://localhost:5173/profile?oauth_action=bind&oauth_provider=generic_oidc
OAUTH_GENERIC_SCOPE=openid email profile

# SMTP notifications
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# WeWork robot notifications
WEWORK_ENABLED=false
WEWORK_WEBHOOK_URL=
WEWORK_WEBHOOK_SECRET=

# Storage
STORAGE_BACKEND=local
STORAGE_ROOT=/app/storage
STORAGE_PUBLIC_URL_PREFIX=/storage
OFFICE_PREVIEW_CONVERTER_BINARY=libreoffice
OFFICE_PREVIEW_CONVERSION_TIMEOUT_SECONDS=30
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Seed data
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_EMAIL=admin@example.local

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
